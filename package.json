{
  "name": "createcanyon-network",
  "version": "0.1.0",
  "private": true,
  "description": "Secure multi-brand digital asset marketplace network for CreateCanyon and its specialist channels.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build --concurrency=1",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @createcanyon/database db:generate",
    "db:migrate": "pnpm --filter @createcanyon/database db:migrate",
    "db:seed": "pnpm --filter @createcanyon/database db:seed",
    "db:studio": "pnpm --filter @createcanyon/database db:studio",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  }
}
