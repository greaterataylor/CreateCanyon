NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://createcanyon:createcanyon-local@postgres:5432/createcanyon
REDIS_URL=redis://:createcanyon-redis-local@redis:6379
API_BASE_URL=http://api:4000
NEXT_PUBLIC_API_BASE_URL=http://api.createcanyon.localhost:4000
OIDC_ISSUER_URL=http://auth.createcanyon.localhost:8080/realms/createcanyon
OIDC_AUDIENCE=createcanyon-api
OIDC_CLIENT_ID=createcanyon-web
OIDC_CLIENT_SECRET=local-web-secret-change-me
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=cc_session
HOST_ALLOWLIST=createcanyon.localhost,graphicgrounds.localhost,melodymerchant.localhost,filefoyer.localhost,programplaza.localhost
CORS_ALLOWED_ORIGINS=http://createcanyon.localhost:3000,http://graphicgrounds.localhost:3000,http://melodymerchant.localhost:3000,http://filefoyer.localhost:3000,http://programplaza.localhost:3000,http://sell.createcanyon.localhost:3001,http://admin.createcanyon.localhost:3002
S3_REGION=us-east-1
S3_ENDPOINT=http://storage.createcanyon.localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=createcanyon-local
S3_SECRET_ACCESS_KEY=createcanyon-local-secret
S3_QUARANTINE_BUCKET=createcanyon-quarantine
S3_ORIGINALS_BUCKET=createcanyon-originals
S3_PREVIEWS_BUCKET=createcanyon-previews
ASSET_PUBLIC_BASE_URL=http://assets.createcanyon.localhost:9000/createcanyon-previews
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=120
MAX_UPLOAD_BYTES=2147483648
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=createcanyon-search-local
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAIL_FROM=no-reply@createcanyon.localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
LICENSE_SIGNING_SECRET=replace-with-a-separate-32-byte-random-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
PAYMENTS_MODE=stub
PLATFORM_FEE_BPS=3000
PAYOUT_RESERVE_DAYS=14
ALLOW_INSECURE_LOCAL_AUTH=false
