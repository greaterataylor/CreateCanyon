# LOCAL DEVELOPMENT ONLY. Copy to .env at the repository root.
# All values labelled local are intentionally public fixtures, not real credentials.
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://createcanyon_app:local-app-password-change-me@127.0.0.1:5432/createcanyon
MIGRATION_DATABASE_URL=postgresql://createcanyon_owner:local-database-password-change-me@127.0.0.1:5432/createcanyon
REDIS_URL=redis://:local-redis-password-change-me@127.0.0.1:6379/0
API_BASE_URL=http://127.0.0.1:4000
OIDC_ISSUER_URL=http://localhost:8080/realms/createcanyon
OIDC_AUDIENCE=createcanyon-api
STOREFRONT_OIDC_CLIENT_ID=cc-storefront
STOREFRONT_OIDC_CLIENT_SECRET=local-storefront-client-secret-change-me
DASHBOARD_OIDC_CLIENT_ID=cc-dashboard
DASHBOARD_OIDC_CLIENT_SECRET=local-dashboard-client-secret-change-me
ADMIN_OIDC_CLIENT_ID=cc-admin
ADMIN_OIDC_CLIENT_SECRET=local-admin-client-secret-change-me
SESSION_SECRET=local-session-encryption-secret-32-bytes-change-me
SESSION_MAX_AGE_SECONDS=28800
HOST_ALLOWLIST=localhost,127.0.0.1,createcanyon.localhost,graphicgrounds.localhost,melodymerchant.localhost,filefoyer.localhost,programplaza.localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://createcanyon.localhost:3000,http://graphicgrounds.localhost:3000,http://melodymerchant.localhost:3000,http://filefoyer.localhost:3000,http://programplaza.localhost:3000
STOREFRONT_APP_URL=http://localhost:3000
DASHBOARD_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
INDEX_STOREFRONT=false
ALLOW_INSECURE_LOCAL_AUTH=false
S3_REGION=ap-southeast-2
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=local-minio-user
S3_SECRET_ACCESS_KEY=local-minio-password-change-me
S3_QUARANTINE_BUCKET=cc-quarantine
S3_ORIGINALS_BUCKET=cc-originals
S3_PREVIEWS_BUCKET=cc-previews
ASSET_PUBLIC_BASE_URL=http://127.0.0.1:9000/cc-previews
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=120
MAX_UPLOAD_BYTES=2147483648
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=local-typesense-key-change-me
PAYMENTS_MODE=stub
STRIPE_SECRET_KEY=sk_test_local_stub_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_local_stub_not_a_real_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TAX_MODE=disabled
STRIPE_TAX_CODE=txcd_10000000
PLATFORM_FEE_BPS=3000
PAYOUT_RESERVE_DAYS=14
LICENSE_SIGNING_SECRET=local-license-signing-secret-change-me-32-bytes
PRODUCTION_LAUNCH_APPROVED=false
WORKER_KIND=all
WORKER_POLL_INTERVAL_MS=1000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_MAX_STREAM_BYTES=2147483648
ALLOW_UNSCANNED_DEV_FIXTURES=false
PROCESSOR_MODE=container
PROCESSOR_IMAGE=createcanyon-processor:local
PROCESSOR_TEMP_DIR=/tmp
CODE_SCANNERS=
ENABLE_AUDIO_PROCESSOR=true
ENABLE_DOCUMENT_PROCESSOR=true
EMAIL_PROVIDER=smtp
MAIL_FROM=no-reply@createcanyon.localhost
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SES_REGION=ap-southeast-2
