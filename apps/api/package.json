    "@createcanyon/database": "workspace:*",
    "@createcanyon/domain": "workspace:*",
    "@createcanyon/observability": "workspace:*",
    "@createcanyon/security": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
