{
  "name": "@createcanyon/workers",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@createcanyon/config": "workspace:*",
    "@createcanyon/database": "workspace:*",
    "@createcanyon/domain": "workspace:*",
    "@createcanyon/payments": "workspace:*",
    "@createcanyon/search": "workspace:*",
    "@aws-sdk/client-s3": "3.922.0",
    "@aws-sdk/lib-storage": "3.922.0",
    "@aws-sdk/client-sesv2": "3.922.0",
    "nodemailer": "7.0.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.3",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vitest": "4.1.10"
  }
}
