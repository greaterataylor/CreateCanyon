{
  "name": "@createcanyon/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts", "./schema": "./src/schema.ts" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": { "@createcanyon/contracts": "workspace:*", "drizzle-orm": "^0.45.2", "postgres": "^3.4.7" },
  "devDependencies": { "@types/node": "^22.18.0", "drizzle-kit": "^0.31.10", "tsx": "^4.20.6", "vitest": "^4.1.10" }
}
